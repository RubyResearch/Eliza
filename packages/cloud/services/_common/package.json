{
  "name": "@elizaos/cloud-services-common",
  "version": "1.0.0",
  "description": "Shared utilities for cloud-services packages (structured logger, k8s service-account helpers).",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./logger": "./src/logger.ts",
    "./k8s-service-account": "./src/k8s-service-account.ts",
    "./k8s-deployment-wake": "./src/k8s-deployment-wake.ts",
    "./identity-link-code": "./src/identity-link-code.ts",
    "./integer-env": "./src/integer-env.ts",
    "./gateway-auth": "./src/gateway-auth.ts",
    "./hash-router": "./src/hash-router.ts",
    "./personal-shared-failure": "./src/personal-shared-failure.ts",
    "./response-attempts": "./src/response-attempts.ts",
    "./retry": "./src/retry.ts",
    "./telegram-connector": "./src/telegram-connector.ts",
    "./telegram-delivery": "./src/telegram-delivery.ts",
    "./gateway-routing": "./src/gateway-routing.ts",
    "./gateway-forward": "./src/gateway-forward.ts",
    "./bounded-fetch": "./src/bounded-fetch.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test tests src",
    "lint": "bunx @biomejs/biome check --write --unsafe .",
    "lint:check": "bunx @biomejs/biome check .",
    "lint:fix": "bunx @biomejs/biome check --write --unsafe .",
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format ."
  },
  "dependencies": {
    "@elizaos/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "bun-types": "1.3.14",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3"
  }
}
