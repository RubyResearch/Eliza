{
  "name": "@elizaos/cloud-api",
  "private": true,
  "version": "2.0.3-beta.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "lint": "bunx @biomejs/biome check --write --unsafe .",
    "lint:check": "bunx @biomejs/biome check .",
    "lint:fix": "bunx @biomejs/biome check --write --unsafe .",
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format .",
    "dev": "node ../scripts/admin/dev/cloud-api-dev.mjs",
    "dev:full": "node ../scripts/admin/dev/cloud-api-dev.mjs --with-control-plane",
    "agent:build": "node ../scripts/admin/dev/build-cloud-agent-image.mjs",
    "deploy": "wrangler deploy --env production",
    "codegen": "node src/_generate-router.mjs",
    "check:router-contract": "node test/_router-contract.mjs",
    "build": "tsc6 --noEmit",
    "typecheck": "tsc --noEmit && bun run check:router-contract && bun run check:worker-bundle",
    "check:worker-bundle": "wrangler deploy --env production --dry-run --outdir .wrangler-dry-run",
    "preflight:subscription-catalog": "bun --conditions=eliza-source ../scripts/admin/preflight-subscription-catalog.ts",
    "test": "node test/run-unit-isolated.mjs",
    "test:batch": "bun test __tests__",
    "test:audit": "node test/_audit-coverage.mjs",
    "test:e2e": "node test/e2e/run-e2e-batches.mjs",
    "test:e2e:foundation": "TEST_SERVER_SCRIPT=dev bun test --preload test/e2e/preload.ts test/e2e/agent-token-flow.test.ts --timeout 120000",
    "voice:measure-warm-turns": "bun scripts/voice-warm-turn-measure.mjs",
    "voice:local-gateway": "bun scripts/local-voice-gateway.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.54",
    "@cloudflare/workers-types": "^4.20260429.1",
    "@elevenlabs/elevenlabs-js": "^2.45.0",
    "@elizaos/cloud-services-common": "workspace:*",
    "@elizaos/cloud-shared": "workspace:*",
    "@elizaos/prompts": "workspace:*",
    "@fal-ai/client": "^1.10.1",
    "@fal-ai/server-proxy": "^1.2.1",
    "@upstash/redis": "^1.37.0",
    "ai": "^6.0.170",
    "drizzle-orm": "0.45.2",
    "file-type": "^22.0.1",
    "hono": "4.13.1",
    "jose": "^6.0.0",
    "music-metadata": "^11.12.3",
    "nanoid": "^6.0.0",
    "stripe": "^22.0.0",
    "telegraf": "^4.16.3",
    "uuid": "^14.0.0",
    "viem": "^2.48.8",
    "wrangler": "^4.0.0",
    "zod": "^4.4.3",
    "@elizaos/shared": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@msgpack/msgpack": "3.1.3",
    "@types/pg": "^8.21.0",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "miniflare": "4.20260730.0",
    "pg": "^8.23.0",
    "typescript": "^6.0.3",
    "ws": "^8.21.3"
  }
}
